generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-auth"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String?
  provider         SessionProvider
  userAgent        String?
  ipAddress        String?
  deviceLabel      String?
  timezone         String?
  refreshAt        DateTime
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime @default(now())
  twoFactorVerifiedAt DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

enum SessionProvider {
  CREDENTIALS
  GOOGLE
}

// ADR-0004: revives the shape 20260514120000_drop_two_factor_tables removed
// (recovery_codes, two_factor_secrets) -- per-method state a boolean cannot
// represent (spec AC-30). userId has no FK: User lives in the `user`
// service's own database (no shared DB, PLATFORM_CONTRACT.md).
enum SecondFactorMethodType {
  TOTP
  EMAIL_CODE
}

model SecondFactorMethod {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  type      SecondFactorMethodType
  enabled   Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([userId, type])
  @@map("second_factor_methods")
}

model BackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("backup_codes")
}
