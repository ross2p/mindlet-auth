#----------------------------------#
#             SERVER               #
#----------------------------------#
PORT=
BASE_URL=
NODE_ENV=


#----------------------------------#
#             DATABASE             #
#----------------------------------#
DATABASE_URL=
DATABASE_PORT=5433


#----------------------------------#
#               JWT                #
#----------------------------------#
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d


#----------------------------------#
#             REDIS / CACHE        #
#----------------------------------#
REDIS_URL=redis://localhost:6379


#----------------------------------#
#          2FA (TOTP)              #
#----------------------------------#
# Base64-encoded 32-byte key for AES-256-GCM (required secret — do not hardcode)
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_ISSUER=Mindlet


#----------------------------------#
#             SWAGGER              #
#----------------------------------#
SWAGGER_USER=
SWAGGER_PASSWORD=


#----------------------------------#
#             SENTRY               #
#----------------------------------#
SENTRY_DSN=
